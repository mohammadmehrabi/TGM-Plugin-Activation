msgstr[1] "این پوسته افزونه زیر را پیشنهاد می‌کند: %1$s."

#. translators: 1: plugin name(s).
#: class-tgm-plugin-activation.php:355
#, php-format
msgid ""
"The following plugin needs to be updated to its latest version to ensure "
"maximum compatibility with this theme: %1$s."
msgid_plural ""
"The following plugins need to be updated to their latest version to ensure "
"maximum compatibility with this theme: %1$s."
msgstr[0] ""
"افزونه‌های زیر باید به آخرین نسخه به‌روزرسانی شوند تا بیشترین سازگاری را با این "
"پوسته داشته باشند: %1$s."
msgstr[1] ""
"افزونه زیر باید به آخرین نسخه به‌روزرسانی شود تا بیشترین سازگاری را با این "
"پوسته داشته باشد: %1$s."

#. translators: 1: plugin name(s).
#: class-tgm-plugin-activation.php:361
#, php-format
msgid "There is an update available for: %1$s."
msgid_plural "There are updates available for the following plugins: %1$s."
